# Build-Zeit-Variablen. Diese Datei dokumentiert alle verfügbaren Variablen;
# eine echte .env.local wird nicht committed.

# Basis-URL, unter der die App ausgeliefert wird (für absolute Links in PWA-Manifest etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Harte Obergrenze für Dekompressionsbomben-Schutz (Megapixel), siehe domain/config
NEXT_PUBLIC_MAX_MEGAPIXELS=256

# Maximale PDF-Seitenzahl pro Job (Phase 3, noch nicht implementiert)
NEXT_PUBLIC_MAX_PDF_PAGES=500
